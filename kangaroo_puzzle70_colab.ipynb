{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# 🚀 Kangaroo Puzzle 70 - Complete Colab Deployment\n",
        "\n",
        "Production-ready GLV Kangaroo with:\n",
        "- ✅ GLV Endomorphism (ψ orbit, factor √3)\n",
        "- ✅ Negation Symmetry (factor 2)\n",
        "- ✅ Combined 75% search reduction\n",
        "- ✅ Auto-checkpoint to Google Drive\n",
        "- ✅ Auto-resume on disconnect\n",
        "- ✅ Sanity test (-test flag)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 1️⃣ Mount Google Drive & Install Dependencies\n",
        "from google.colab import drive\n",
        "drive.mount('/content/drive', force_remount=True)\n",
        "\n",
        "# Install dependencies\n",
        "!apt-get update -qq && apt-get install -y -qq cmake build-essential git 2>/dev/null\n",
        "\n",
        "# Check GPU\n",
        "import torch\n",
        "if torch.cuda.is_available():\n",
        "    gpu_name = torch.cuda.get_device_name(0)\n",
        "    gpu_mem = torch.cuda.get_device_properties(0).total_memory / 1e9\n",
        "    print(f'GPU: {gpu_name} ({gpu_mem:.1f} GB)')\n",
        "else:\n",
        "    print('⚠️ No GPU detected! Enable GPU in Colab: Runtime → Change runtime type → GPU')"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 2️⃣ Clone & Setup Repository\n",
        "!git clone https://github.com/xicuvufv-bot/BITCOIN_PUZZLE_LAB.git /content/BITCOIN_PUZZLE_LAB 2>/dev/null\n",
        "%cd /content/BITCOIN_PUZZLE_LAB/production/native\n",
        "\n",
        "# Verify files exist\n",
        "!ls -la kangaroo_glv_gpu.cu Makefile"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 3️⃣ Fix any hardcoded CUDA paths\n",
        "import os\n",
        "with open('kangaroo_glv_gpu.cu', 'r') as f:\n",
        "    content = f.read()\n",
        "\n",
        "old_paths = ['/usr/local/cuda-8.0', '/usr/local/cuda-10', '/usr/local/cuda-11', '/usr/local/cuda-12']\n",
        "for old in old_paths:\n",
        "    if old in content:\n",
        "        content = content.replace(old, '/usr/local/cuda')\n",
        "        print(f'Fixed hardcoded path: {old}')\n",
        "\n",
        "with open('kangaroo_glv_gpu.cu', 'w') as f:\n",
        "    f.write(content)\n",
        "print('✅ CUDA paths verified')"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 4️⃣ Build with optimal flags for T4 (sm_75)\n",
        "import torch\n",
        "\n",
        "# Auto-detect GPU architecture\n",
        "if torch.cuda.is_available():\n",
        "    cc_major, cc_minor = torch.cuda.get_device_capability(0)\n",
        "    arch_map = {'7.5': 'sm_75', '8.0': 'sm_80', '8.6': 'sm_86', '8.9': 'sm_89', '9.0': 'sm_90'}\n",
        "    ARCH = arch_map.get(f'{cc_major}.{cc_minor}', 'sm_75')\n",
        "    print(f'GPU: {torch.cuda.get_device_name(0)}')\n",
        "    print(f'Compute Capability: {cc_major}.{cc_minor} -> ARCH={ARCH}')\n",
        "else:\n",
        "    ARCH = 'sm_75'\n",
        "    print('No GPU detected, defaulting to sm_75')\n",
        "\n",
        "# Build with Makefile (preferred)\n",
        "!make clean 2>/dev/null || true\n",
        "!make WITHGPU=1 ARCH=$ARCH 2>&1 | tail -20"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 5️⃣ Fallback: Direct nvcc compile if Makefile fails\n",
        "import os\n",
        "if not os.path.exists('kangaroo_glv_gpu'):\n",
        "    print('Trying direct nvcc compilation...')\n",
        "    !nvcc -O3 -arch=$ARCH -Xcompiler=/O2 -Xptxas -O3 -I. -std=c++17 -o kangaroo_glv_gpu kangaroo_glv_gpu.cu -lcudart 2>&1 | tail -10\n",
        "else:\n",
        "    print('✅ Binary already exists')"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 6️⃣ Run Sanity Test (-test flag)\n",
        "!./kangaroo_glv_gpu -test"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 7️⃣ Setup Google Drive Checkpoint Directory\n",
        "from google.colab import drive\n",
        "drive.mount('/content/drive', force_remount=True)\n",
        "\n",
        "CHECKPOINT_DIR = '/content/drive/MyDrive/Kangaroo_Checkpoints'\n",
        "os.makedirs(CHECKPOINT_DIR, exist_ok=True)\n",
        "CHECKPOINT_FILE = f'{CHECKPOINT_DIR}/puzzle_70.work'\n",
        "print(f'Checkpoint: {CHECKPOINT_FILE}')"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 8️⃣ LAUNCH PUZZLE 70 SEARCH\n",
        "print('='*60)\n",
        "print('🚀 LAUNCHING PUZZLE 70 SEARCH')\n",
        "print('='*60)\n",
        "print('Puzzle 70: Range [2^69, 2^70-1]')\n",
        "print('GPU: T4 (sm_75) | Budget: 2^35 ops')\n",
        "print('Checkpoint: Auto-save every 5 min to Google Drive')\n",
        "print('Press Ctrl+C to stop (progress auto-saved)')\n",
        "print('='*60)\n",
        "\n",
        "cmd = [\n",
        "    './kangaroo_glv_gpu',\n",
        "    '-p', '70',\n",
        f'-c {CHECKPOINT_DIR}/puzzle_70.work',\n",
        "    '-dpbits', '26',\n",
        "    '-budget', '35',\n",
        "    '-sleep', '300'\n",
        "]\n",
        "\n",
        "print(f'Launching: {' '.join(cmd)}')\n",
        "print('-' * 60)\n",
        "\n",
        "import subprocess\n",
        "proc = subprocess.Popen(\n",
        "    cmd, \n",
        "    stdout=subprocess.PIPE, \n",
        "    stderr=subprocess.STDOUT,\n",
        "    text=True, \n",
        "    bufsize=1\n",
        ")\n",
        "\n",
        "try:\n",
        "    for line in proc.stdout:\n",
        "        print(line.rstrip())\n",
        "        if 'FOUND' in line or 'COLLISION' in line:\n",
        "            print(f'🎉 SUCCESS: {line.strip()}')\n",
        "            break\nexcept KeyboardInterrupt:\n",
        "    print('\\n🛑 Interrupted - checkpoint saved to Drive')\nexcept Exception as e:\n",
        "    print(f'Error: {e}')"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 9️⃣ AUTO-RESUME AFTER DISCONNECT\n",
        "# Just re-run this cell after reconnecting:\n",
        "RESUME_CMD = [\n",
        "    './kangaroo_glv_gpu',\n",
        "    '-p', '70',\n",
        f'-c {CHECKPOINT_DIR}/puzzle_70.work',\n",
        "    '-dpbits', '26',\n",
        "    '-budget', '35',\n",
        "    '-sleep', '300'\n",
        "]\n",
        "\n",
        "import subprocess\n",
        "proc = subprocess.Popen(\n",
        "    RESUME_CMD, \n",
        "    stdout=subprocess.PIPE, \n",
        "    stderr=subprocess.STDOUT,\n",
        "    text=True, \n",
        "    bufsize=1\n",
        ")\n",
        "\n",
        "for line in proc.stdout:\n",
        "    print(line.rstrip())\n",
        "    if 'FOUND' in line or 'COLLISION' in line:\n",
        "        print(f'🎉 SUCCESS: {line.strip()}')\n",
        "        break"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 📊 Expected Performance on Colab\n",
